limit_req_zone $binary_remote_addr zone=one:10m rate=90r/m;
server {
    # Port to listen on.

    # The domain name for your API. Replace with your actual domain.
    server_name api.forum.dimaseka.my.id;

    # This block handles threads path requests
    location ~ ^/threads(/.*)?$ {
        limit_req zone=one burst=10 nodelay;
        limit_req_status 429;
        # Proxying the request to the API backend.
        # This is the most critical part. It forwards the request to your application.
        proxy_pass http://localhost:5000;

        # These headers are standard practice for maintaining
        # correct client and host information in the forwarded request.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;


    }

    # This block handles all requests.
    location / {
        # Proxying the request to the API backend.
        # This is the most critical part. It forwards the request to your application.
        proxy_pass http://localhost:5000;

        # These headers are standard practice for maintaining
        # correct client and host information in the forwarded request.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api.forum.dimaseka.my.id/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.forum.dimaseka.my.id/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = api.forum.dimaseka.my.id) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name api.forum.dimaseka.my.id;
    return 404; # managed by Certbot


}
